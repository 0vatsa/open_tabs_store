{
  "manifest_version": 3,
  "name": "Open Tabs Store",
  "version": "2.0.0",
  "description": "Continuously backs up your open tabs and windows locally, so you can bring them back after a crash.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "favicon"],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tabs Store",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/ui/manager.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
